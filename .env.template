# ============================================
# RAG Testing Pipeline - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME=rag-service
ENVIRONMENT=docker # local or docker
LOG_LEVEL=DEBUG
API_PORT=8000

# ============================================
# PostgreSQL Database
# ============================================
# For scripts that run on the host machine, use localhost
POSTGRES_SCRIPT_HOST=localhost
POSTGRES_SCRIPT_PORT=5432

# Connect for API from Docker containers (use host.docker.internal to reach host machine)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# For local development, use localhost and default port
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Connection for postgres container
POSTGRES_DB=rag_testing
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_EXTERNAL_PORT=5434
POSTGRES_INITDB_ARGS=-E UTF8
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Vector Store Configuration
# ============================================
# Default vector store: postgresql (with pgvector) or elasticsearch
VECTOR_STORE_PROVIDER=postgresql

# pgvector Settings
PGVECTOR_DIMENSION=768
PGVECTOR_INDEX_TYPE=hnsw  # hnsw or ivfflat
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

# Elasticsearch Settings (if using Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=knowledge_base
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ============================================
# Embedding Provider Configuration
# ============================================
# Options: local, vertex, azure
EMBEDDING_PROVIDER=local

# Local Embeddings (sentence-transformers)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LOCAL_EMBEDDING_DIMENSION=768
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_DEVICE=cpu  # cpu or cuda

# GCP Vertex AI Embeddings
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_EMBEDDING_MODEL=text-embedding-004
VERTEX_EMBEDDING_DIMENSION=768

# Azure OpenAI Embeddings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSION=1536

# ============================================
# LLM Provider Configuration
# ============================================
# Options: ollama, vertex, azure, openai, bedrock, claude, copilot
LLM_PROVIDER=ollama

# Ollama (Local)
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434 # Connect to host machine's Ollama
OLLAMA_MODEL=qwen2.5
# OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2000

# GCP Vertex AI (Gemini)
VERTEX_LLM_MODEL=gemini-2.0-flash-exp
VERTEX_TEMPERATURE=0.7
VERTEX_MAX_TOKENS=2000

# Azure OpenAI (GPT-4)
AZURE_LLM_DEPLOYMENT=gpt-4o
AZURE_TEMPERATURE=0.7
AZURE_MAX_TOKENS=2000

# OpenAI (Direct API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_ORGANIZATION=  # Optional

# AWS Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=
BEDROCK_TEMPERATURE=0.7
BEDROCK_MAX_TOKENS=2000

# Anthropic Claude (Direct API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=2000

# GitHub Copilot
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o  # Copilot uses OpenAI models
COPILOT_TEMPERATURE=0.7
COPILOT_MAX_TOKENS=2000

# ============================================
# Chunking Configuration
# ============================================
CHUNK_STRATEGY=recursive  # fixed, recursive, semantic
CHUNK_SIZE=300  # words
CHUNK_OVERLAP=30  # words
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=500

# ============================================
# Retrieval Configuration
# ============================================
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
RELEVANCE_THRESHOLD=0.7

# Reranking (optional)
ENABLE_RERANKING=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10

# Query Expansion (optional)
ENABLE_QUERY_EXPANSION=false
EXPANSION_METHOD=synonym  # synonym, llm, embedding
MAX_EXPANSIONS=3

# ============================================
# Metadata & Boosting
# ============================================
# Recency boosting
RECENCY_BOOST_ENABLED=true
RECENCY_VERY_RECENT_DAYS=30
RECENCY_RECENT_DAYS=90
RECENCY_MODERATE_DAYS=180
RECENCY_DECAY_RATE=730.0  # Half-life in days

# Quality boosting (based on feedback)
QUALITY_BOOST_ENABLED=true
QUALITY_MIN_FEEDBACK=3  # Min feedback count to apply boost

# Popularity boosting
POPULARITY_BOOST_ENABLED=true

# ============================================
# Generation Configuration
# ============================================
PROMPT_TEMPLATE=default
PROMPT_VERSION=1.0
INCLUDE_SOURCES=true
MAX_CONTEXT_TOKENS=8000
RESPONSE_FORMAT=markdown  # text, markdown, json
INCLUDE_CITATIONS=true
CITATION_FORMAT=inline  # inline, footnote, list

# Content Filters
CONTENT_FILTER_ENABLED=true
PII_DETECTION_ENABLED=false
TOXIC_FILTER_ENABLED=false

# ============================================
# System Configuration
# ============================================
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF=exponential  # linear, exponential, constant

# Caching
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
BURST_LIMIT=10

# ============================================
# Ingestion Configuration
# ============================================
# Web Scraping
SCRAPE_MAX_DEPTH=3
SCRAPE_MAX_PAGES=100
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_USER_AGENT=RAG-Testing-Bot/1.0

# Playwright (for JS-rendered pages)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ============================================
# Monitoring & Observability
# ============================================
LOG_QUERIES=true
LOG_RESPONSES=true
LOG_FORMAT=json  # json or text

# Metrics Export (optional)
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL_SECONDS=60

# ============================================
# GCP Credentials (if using Vertex AI)
# ============================================
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# Azure Credentials (if using Azure OpenAI)
# ============================================
# Use AZURE_OPENAI_API_KEY above, or set these for managed identity:
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# ============================================
# Development & Testing
# ============================================
DEBUG=false
RELOAD=false  # Auto-reload on code changes (uvicorn)
