{
  "info": {
    "name": "RAG MCP API",
    "description": "RAG Testing Pipeline API — endpoints for ingestion, querying, feedback, metrics, profiles, and reporting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Root endpoint — returns service name, version, and status."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Health check — returns service and database status."
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Ingest URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/docs/page\",\n  \"profile\": \"default\",\n  \"depth\": 1,\n  \"max_pages\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": ["{{base_url}}"],
              "path": ["ingest"]
            },
            "description": "Ingest a document by URL. Scrapes, chunks, embeds, and stores in the vector database."
          }
        },
        {
          "name": "Ingest Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Your document content here.\",\n  \"title\": \"My Document\",\n  \"profile\": \"default\",\n  \"metadata\": {\n    \"author\": \"team\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": ["{{base_url}}"],
              "path": ["ingest"]
            },
            "description": "Ingest direct text content. Chunks, embeds, and stores in the vector database."
          }
        }
      ]
    },
    {
      "name": "Query",
      "item": [
        {
          "name": "Query (Full RAG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is AKS?\",\n  \"profile\": \"default\",\n  \"top_k\": 5,\n  \"retrieve_only\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": ["{{base_url}}"],
              "path": ["query"]
            },
            "description": "Full RAG query — retrieves relevant chunks and generates an LLM answer with sources and citations."
          }
        },
        {
          "name": "Query (Retrieve Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is AKS?\",\n  \"profile\": \"default\",\n  \"top_k\": 5,\n  \"retrieve_only\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": ["{{base_url}}"],
              "path": ["query"]
            },
            "description": "Retrieve-only mode — returns raw chunks without LLM generation. Used by the MCP server / Copilot."
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"score\": 8,\n  \"comment\": \"Accurate and helpful answer.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/feedback",
              "host": ["{{base_url}}"],
              "path": ["feedback"]
            },
            "description": "Submit feedback for a query. Score 0-10 (7+ = satisfied)."
          }
        }
      ]
    },
    {
      "name": "Metrics & Reporting",
      "item": [
        {
          "name": "Get Metrics (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["metrics"]
            },
            "description": "Aggregated metrics across all profiles — total queries, avg latency, avg cost, satisfaction rate."
          }
        },
        {
          "name": "Get Metrics (By Profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics?profile=default",
              "host": ["{{base_url}}"],
              "path": ["metrics"],
              "query": [
                {
                  "key": "profile",
                  "value": "default"
                }
              ]
            },
            "description": "Aggregated metrics for a specific profile."
          }
        },
        {
          "name": "List Profiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profiles",
              "host": ["{{base_url}}"],
              "path": ["profiles"]
            },
            "description": "List all available configuration profiles."
          }
        },
        {
          "name": "Comparison Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/report",
              "host": ["{{base_url}}"],
              "path": ["report"]
            },
            "description": "Cross-profile comparison report — latency, cost, satisfaction, config details."
          }
        }
      ]
    }
  ]
}
